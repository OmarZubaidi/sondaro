# copy to .env and fill in. .env is git-ignored and is never overwritten by
# deploy.sh, so the values you set on the VM survive every deploy.
#
# SECRETS AND WIRING LIVE HERE. Everything behavioural — home location, horizon,
# driving-hour bases, alert threshold — is seeded from here on first run and then
# owned by the UI at /settings. Editing those below after first run does nothing.

# --- Lidarr (read-only; the app refuses to issue any non-GET) ---------------
# Lidarr > Settings > General > API Key
LIDARR_URL=http://192.168.1.10:8686
LIDARR_API_KEY=

# --- event providers --------------------------------------------------------
# https://developer.ticketmaster.com — free, self-serve, 5000 calls/day
TICKETMASTER_API_KEY=
# https://data.jambase.com/pricing — free Developer tier, 1000 calls/MONTH.
# Optional. Leave empty and small-venue coverage gets noticeably worse.
JAMBASE_API_KEY=

# --- driving times and geocoding -------------------------------------------
# https://openrouteservice.org/dev/#/signup — free, 2000 calls/day.
# Optional. Without it drive times fall back to estimates, marked as such.
ORS_API_KEY=

# --- affinity: where your play counts come from -----------------------------
# ListenBrainz is tried first, Last.fm second, and if neither answers every
# artist is weighted equally.
LISTENBRAINZ_USER=
LASTFM_API_KEY=
LASTFM_USER=

# --- notifications ----------------------------------------------------------
# ntfy > Account > Access Tokens
NTFY_URL=https://ntfy.example-tailnet.ts.net
NTFY_TOKEN=
# new concert matches (gated by the alert threshold you set in the UI)
NTFY_TOPIC_ALERTS=sondaro
# service health and degradation only, never gated
NTFY_TOPIC_STATUS=services

# --- first-run seeds for settings the UI owns afterwards --------------------
TZ=UTC
HOME_LAT=38.0
HOME_LON=-95.0
HOME_LABEL=Home
HOME_HORIZON_DAYS=180
NOTIFY_MIN_SCORE=0.35
