# copy to .env and fill in. git-ignored, and deploy.sh never overwrites it.
# secrets and wiring only — everything behavioural is owned by the UI.

# --- Lidarr (read-only; the app refuses to issue any non-GET) ---------------
# Settings > General > API Key
LIDARR_URL=http://192.168.1.10:8686
LIDARR_API_KEY=

# --- event providers --------------------------------------------------------
# developer.ticketmaster.com — free, 5000/day. Paste the "Consumer Key"; the
# secret next to it is for an OAuth flow this doesn't use.
TICKETMASTER_API_KEY=
# data.jambase.com/pricing — free tier, 1000/MONTH. Only ever called for
# artists Ticketmaster found nothing for.
# !! BILLS $0.05/call past the quota instead of returning 429. Sondaro caps
# !! itself at 500/month; there is no protection from their end.
JAMBASE_API_KEY=
# Both jambase vars must be set or the provider stays off — guessing at a base
# url would cost real money to find out it was wrong. No trailing slash.
JAMBASE_BASE_URL=

# --- driving times and geocoding -------------------------------------------
# openrouteservice.org/dev/#/signup — free, 2000/day. Optional; without it
# drive times are estimates, marked as such.
ORS_API_KEY=
# Only to pin a host. Otherwise api.heigit.org is tried, then the old
# api.openrouteservice.org, and whichever answers is remembered.
ORS_BASE_URL=

# --- affinity: where your play counts come from -----------------------------
# ListenBrainz first, Last.fm second, else every artist weighs the same.
LISTENBRAINZ_USER=
LASTFM_API_KEY=
LASTFM_USER=

# --- tailscale ----------------------------------------------------------------
# Reusable auth key from the admin console > Settings > Keys. Only consumed on
# first start; after that the state volume holds the identity.
TS_AUTHKEY=

# --- home location ----------------------------------------------------------
# Coordinates, name, country and timezone, from one GET /api/config.
# Token: HA > profile > Security > Long-lived access tokens.
# The lan address, not the ts.net one: docker's resolver can't see tailscale's
# MagicDNS, so a *.ts.net name here fails with "Name or service not known".
HASS_URL=http://192.168.1.20:8123
HASS_TOKEN=

# --- notifications ----------------------------------------------------------
# OFF. ntfy has to be https on its own hostname, and that name only exists on
# the tailnet — which the server isn't on. Docker's resolver wouldn't see
# MagicDNS even if it were, so turning this back on needs tailscale on the vm
# *plus* an extra_hosts entry pinning the name to its 100.x address.
# Blank means notify.send returns before it builds a request: no calls, no
# errors. Nothing else degrades, you just get no alerts.
NTFY_URL=
# ntfy > Account > Access Tokens
NTFY_TOKEN=
# new shows, gated by the alert threshold
NTFY_TOPIC_ALERTS=sondaro
# health only, never gated
NTFY_TOPIC_STATUS=services

# --- first-run seeds for settings the UI owns afterwards --------------------
HOME_HORIZON_DAYS=180
NOTIFY_MIN_SCORE=0.35
