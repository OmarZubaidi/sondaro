# copy to .env and fill in. .env is git-ignored and is never overwritten by
# deploy.sh, so the values you set on the VM survive every deploy.
#
# SECRETS AND WIRING LIVE HERE. Everything behavioural — home location, horizon,
# driving-hour bases, alert threshold — is seeded from here on first run and then
# owned by the UI at /settings. Editing those below after first run does nothing.

# --- Lidarr (read-only; the app refuses to issue any non-GET) ---------------
# Lidarr > Settings > General > API Key
LIDARR_URL=http://192.168.1.10:8686
LIDARR_API_KEY=

# --- event providers --------------------------------------------------------
# https://developer.ticketmaster.com — free, self-serve, 5000 calls/day.
# The portal calls this your "Consumer Key". Paste that. The "Consumer Secret"
# sitting next to it is only for the OAuth flow the Commerce API uses, and is
# not needed here — Discovery authenticates with ?apikey=<consumer key>.
TICKETMASTER_API_KEY=
# https://data.jambase.com/pricing — free Developer tier, 1000 calls/MONTH.
#
# !! JamBase BILLS $0.05/call above the monthly quota instead of returning 429.
# !! Sondaro caps itself at 500/month so the gap absorbs any bug, but there is
# !! no protection from their end. Both variables below must be set or the
# !! provider stays off entirely — guessing at a base URL would spend real money
# !! discovering the guess was wrong.
#
# Its role is narrow on purpose: it is only ever called for artists Ticketmaster
# returned nothing for. The Developer tier has no External Identifiers, so it
# can't match on MusicBrainz ids and is a name search like Ticketmaster's.
#
# Sent as an "Authorization: Bearer <key>" header, not a query parameter.
JAMBASE_API_KEY=
# Confirm against the "API Spec & Sandbox" docs; no trailing slash.
# The v3 API base is https://api.jambase.com/v3
JAMBASE_BASE_URL=

# --- driving times and geocoding -------------------------------------------
# https://openrouteservice.org/dev/#/signup — free, 2000 calls/day.
# Optional. Without it drive times fall back to estimates, marked as such.
ORS_API_KEY=
# Optional override. HeiGIT is retiring api.openrouteservice.org in favour of
# api.heigit.org; sondaro tries the new host first and falls back to the old
# one, remembering whichever answers. Set this only to pin a specific host.
ORS_BASE_URL=

# --- affinity: where your play counts come from -----------------------------
# ListenBrainz is tried first, Last.fm second, and if neither answers every
# artist is weighted equally.
LISTENBRAINZ_USER=
LASTFM_API_KEY=
LASTFM_USER=

# --- notifications ----------------------------------------------------------
# ntfy > Account > Access Tokens
NTFY_URL=https://ntfy.example-tailnet.ts.net
NTFY_TOKEN=
# new concert matches (gated by the alert threshold you set in the UI)
NTFY_TOPIC_ALERTS=sondaro
# service health and degradation only, never gated
NTFY_TOPIC_STATUS=services

# --- first-run seeds for settings the UI owns afterwards --------------------
TZ=UTC
HOME_LAT=38.0
HOME_LON=-95.0
HOME_LABEL=Home
HOME_HORIZON_DAYS=180
NOTIFY_MIN_SCORE=0.35
